+            sumf[j] = buf_iw[tid];
+            sumf[j] = warp_reduce_sum<warp_size>(sumf[j]);
+        }
+        if (j < ncols_dst) {
+            __syncthreads();
+        }
+    }
+    if (tid >= ncols_dst) {
+        return;
+    }
+    dst[tid*stride_col_dst + row] = sumf[tid];
