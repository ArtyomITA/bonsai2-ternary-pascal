+// I5-BEGIN
+// TOP_K: one row, k <= 32: top-k of one logits row in two launches (the argsort fallback needs ~12 launches and memsets).
+// Order = stable radix sort descending: the 64-bit key is (twiddled float bits, ~index), -0.0 == +0.0 like cub.
+#define TOPK_NB 60
+#define TOPK_BS 256
+
+static __device__ __forceinline__ unsigned long long topk_pack(const float x, const int idx) {
+    unsigned int b = __float_as_uint(x);
+    b = b == 0x80000000u ? 0u : b; // -0.0 == +0.0 for cub
+    const unsigned int u = (b >> 31) ? ~b : (b | 0x80000000u);
+    return ((unsigned long long) u << 32) | (unsigned int) ~idx;
+}
+
+template <int KT>
+static __device__ __forceinline__ void topk_insert(unsigned long long (&l)[KT], const unsigned long long p) {
+    if (p > l[KT-1]) {
+#pragma unroll
+        for (int j = KT-1; j > 0; --j) {
+            l[j] = p > l[j-1] ? l[j-1] : max(l[j], p);
+        }
+        l[0] = max(l[0], p);
+    }
+}
+
+// each lane holds a descending list; k rounds of "pop the best head", lane 0 writes the winners to out
+template <int KT>
+static __device__ __forceinline__ void topk_warp_merge(unsigned long long (&l)[KT], const int k, unsigned long long * out) {
+    for (int r = 0; r < k; ++r) {
+        unsigned long long m = l[0];
+#pragma unroll
+        for (int off = 16; off > 0; off >>= 1) {
+            m = max(m, __shfl_xor_sync(0xffffffff, m, off));
+        }
+        if (l[0] == m) {
+#pragma unroll
+            for (int j = 0; j < KT-1; ++j) {
+                l[j] = l[j+1];
+            }
+            l[KT-1] = 0;
+        }
+        if (threadIdx.x % 32 == 0) {
+            out[r] = m;
+        }
+    }
+}
+
+// all threads of the block: lists in l (any order across threads), result k winners in out (global or shared), then a barrier
+template <int KT>
+static __device__ __forceinline__ void topk_block_merge(unsigned long long (&l)[KT], const int k, unsigned long long * out,
+                                                         unsigned long long (*sm)[32]) {
+    const int warp = threadIdx.x / 32;
+    const int lane = threadIdx.x % 32;
+    topk_warp_merge<KT>(l, k, sm[warp]);
+    __syncthreads();
+    if (warp == 0) {
+#pragma unroll
+        for (int j = 0; j < KT; ++j) {
+            l[j] = (lane < TOPK_BS/32 && j < k) ? sm[lane][j] : 0ull;
+        }
+        topk_warp_merge<KT>(l, k, out);
+    }
+}
+
+// stage 1: TOPK_NB blocks each take a strided slice of the row and leave their k best in tmp
+template <int KT>
+static __global__ void __launch_bounds__(TOPK_BS) topk_f32_stage1(const float * src, unsigned long long * tmp, const int n, const int k) {
+    __shared__ unsigned long long sm[TOPK_BS/32][32];
+
+    unsigned long long l[KT];
+#pragma unroll
+    for (int j = 0; j < KT; ++j) {
+        l[j] = 0ull;
+    }
+    for (int i = blockIdx.x*TOPK_BS + threadIdx.x; i < n; i += TOPK_NB*TOPK_BS) {
+        topk_insert<KT>(l, topk_pack(src[i], i));
+    }
+    topk_block_merge<KT>(l, k, tmp + blockIdx.x*32, sm);
+}
+
+// stage 2: one block merges the TOPK_NB lists
+template <int KT>
+static __global__ void __launch_bounds__(TOPK_BS) topk_f32_stage2(const unsigned long long * tmp, int * dst, const int k) {
+    __shared__ unsigned long long sm[TOPK_BS/32][32];
+    __shared__ unsigned long long fin[32];
+
+    unsigned long long l[KT];
+#pragma unroll
+    for (int j = 0; j < KT; ++j) {
+        l[j] = 0ull;
+    }
+    for (int c = threadIdx.x; c < TOPK_NB*k; c += TOPK_BS) {
+        topk_insert<KT>(l, tmp[(c / k)*32 + c % k]);
+    }
+    topk_block_merge<KT>(l, k, fin, sm);
+    __syncthreads();
+    if (threadIdx.x < k) {
+        dst[threadIdx.x] = (int) ~(unsigned int) fin[threadIdx.x];
+    }
+}
+
+static bool ggml_cuda_top_k_small(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const int k = dst->ne[0];
+    if (src0->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_I32 || !ggml_is_contiguous(src0) ||
+        ggml_nrows(src0) != 1 || src0->ne[0] < 4096 || src0->ne[0] > INT_MAX || k < 1 || k > 32) {
+        return false;
+    }
+    ggml_cuda_pool_alloc<unsigned long long> tmp(ctx.pool(), TOPK_NB*32);
+    cudaStream_t stream = ctx.stream();
+    if (k <= 16) {
+        topk_f32_stage1<16><<<TOPK_NB, TOPK_BS, 0, stream>>>((const float *) src0->data, tmp.get(), src0->ne[0], k);
+        topk_f32_stage2<16><<<1, TOPK_BS, 0, stream>>>(tmp.get(), (int *) dst->data, k);
+    } else {
+        topk_f32_stage1<32><<<TOPK_NB, TOPK_BS, 0, stream>>>((const float *) src0->data, tmp.get(), src0->ne[0], k);
+        topk_f32_stage2<32><<<1, TOPK_BS, 0, stream>>>(tmp.get(), (int *) dst->data, k);
+    }
+    return true;
+}
+
+// I5-END
+
+// I7-F3: F32 strided copy with 32-bit fastdiv indices (cpy_scalar divides in int64: ~6.4 us for 24k floats),
+// up to 4 copies with the same shapes and strides in one launch (blockIdx.y). A copy: same bits.
+struct w1_cpy_ptrs {
+    const char * src[4];
+    char *       dst[4];
+};
+
+static __global__ void w1_cpy_f32_strided(const w1_cpy_ptrs p, const uint32_t ne,
+        const uint3 ne00, const uint3 ne01, const uint3 ne02, const int64_t nb00, const int64_t nb01, const int64_t nb02, const int64_t nb03,
+        const uint3 ne10, const uint3 ne11, const uint3 ne12, const int64_t nb10, const int64_t nb11, const int64_t nb12, const int64_t nb13) {
+    const uint32_t i = blockIdx.x*blockDim.x + threadIdx.x;
+    if (i >= ne) {
+        return;
+    }
+    const uint2 s0 = fast_div_modulo(i,    ne00);
+    const uint2 s1 = fast_div_modulo(s0.x, ne01);
+    const uint2 s2 = fast_div_modulo(s1.x, ne02);
+    const uint2 d0 = fast_div_modulo(i,    ne10);
+    const uint2 d1 = fast_div_modulo(d0.x, ne11);
+    const uint2 d2 = fast_div_modulo(d1.x, ne12);
+    const int64_t xo = s0.y*nb00 + s1.y*nb01 + s2.y*nb02 + s2.x*nb03;
+    const int64_t yo = d0.y*nb10 + d1.y*nb11 + d2.y*nb12 + d2.x*nb13;
+    *(float *) (p.dst[blockIdx.y] + yo) = *(const float *) (p.src[blockIdx.y] + xo);
+}
