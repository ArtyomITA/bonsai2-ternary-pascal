+// I7-F2: RMS_NORM -> MUL(weight) -> SWIGLU split (silu(z) * normed), the gated norm of the GDN layers, in one launch,
+// optionally also the RESHAPE/PERMUTE/CONT that reorders its heads for the folded Hadamard of ssm_out (perm.n > 0: each
+// value is stored at its place in the CONT). Body = rms_norm_f32<256, true> (norm.cu: same loop, block_reduce,
+// scale * x * w), epilogue = unary_gated_op_kernel (silu(z) * g): same bits as the original launches.
+struct w1_perm {
+    uint3    div[4];    // element stride of view dim k over the contiguous SWIGLU output
+    uint3    ne[4];     // view dim k extent
