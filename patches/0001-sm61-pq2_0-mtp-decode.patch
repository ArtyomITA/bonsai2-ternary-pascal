+// same float2 loads, same ggml_cuda_mad order, same warp + smem reduction: same bits.
+template <int ncols_dst>
+static __global__ void __launch_bounds__(256) w1_mul_mat_vec_f32_pair(const float * x_a, const float * x_b, const float * y,
+        float * dst_a, float * dst_b, const int nrows_a, const int ncols2, const int stride_row, const int stride_col_y2,
+        const int stride_col_dst) {
