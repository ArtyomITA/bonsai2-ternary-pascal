+// I7: the fused kernels below read and write each element in the same thread, read first: an output may be the exact
+// in-place reuse of an input (same start, same size, both contiguous, as ggml-alloc does), never a partial overlap
+static bool w1_alias_ok(const ggml_tensor * const * outs, const int nout, const ggml_tensor * const * ins, const int nin) {
+    auto span_overlap = [](const ggml_tensor * a, const ggml_tensor * b) {
+        const char * a0 = (const char *) a->data;
