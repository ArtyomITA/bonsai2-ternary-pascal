+// false: not handled, the caller keeps ggml_cuda_cpy. Contiguous and transposable copies keep their own paths.
+static bool w1_cpy_f32_fast(cudaStream_t stream, const ggml_tensor * const * srcs, ggml_tensor * const * dsts, const int n) {
+    static const bool enabled = !getenv("GGML_CUDA_FAST_CPY") || atoi(getenv("GGML_CUDA_FAST_CPY")) != 0;
+    const ggml_tensor * s = srcs[0];
+    const ggml_tensor * d = dsts[0];
+    const int64_t ne = ggml_nelements(s);
+    if (!enabled || s->type != GGML_TYPE_F32 || d->type != GGML_TYPE_F32 || ne == 0 || ne != ggml_nelements(d) ||
+            ne > INT_MAX || (ggml_is_contiguous(s) && ggml_is_contiguous(d)) ||
+            (s->nb[1] == (int64_t) sizeof(float) && s->ne[3] == 1 && s->nb[2] == s->ne[0]*s->ne[1]*(int64_t) sizeof(float))) {
+        return false;
+    }
+    w1_cpy_ptrs p;
+    for (int k = 0; k < n; ++k) {
+        p.src[k] = (const char *) srcs[k]->data;
+        p.dst[k] = (char *) dsts[k]->data;
+    }
+    const int bs = 256;
+    const dim3 grid((ne + bs - 1)/bs, n, 1);
+    w1_cpy_f32_strided<<<grid, bs, 0, stream>>>(p, (uint32_t) ne,
+        init_fastdiv_values(s->ne[0]), init_fastdiv_values(s->ne[1]), init_fastdiv_values(s->ne[2]), s->nb[0], s->nb[1], s->nb[2], s->nb[3],
+        init_fastdiv_values(d->ne[0]), init_fastdiv_values(d->ne[1]), init_fastdiv_values(d->ne[2]), d->nb[0], d->nb[1], d->nb[2], d->nb[3]);
+    return true;
+}
