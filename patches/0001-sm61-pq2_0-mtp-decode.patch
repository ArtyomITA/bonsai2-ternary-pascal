+static __global__ void w1_conv_state_kernel(const float * cache, const int32_t * ids, const int64_t row_stride,
+        const char * src1, const int64_t src1_col_stride, float * cat, const int nc, const int rows, const int T,
+        const w1_conv_state_plan p) {
+    const int c = blockIdx.x*blockDim.x + threadIdx.x;
+    if (c >= rows) {
+        return;
+    }
+    const float * srow = cache + (int64_t) ids[0]*row_stride + (int64_t) c*nc;
+    float v[16];
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        if (i < nc) {
+            v[i] = srow[i];
+        }
+    }
+#pragma unroll
+    for (int t = 0; t < 8; ++t) {
+        if (t < T) {
+            v[nc + t] = *(const float *) (src1 + t*src1_col_stride + (int64_t) c*sizeof(float));
+        }
+    }
+    float * crow = cat + (int64_t) c*(nc + T);
+    for (int i = 0; i < nc + T; ++i) {
+        crow[i] = v[i];
+    }
+    for (int k = 0; k < p.n_cpy; ++k) {
+        float * d = p.dst[k] + (int64_t) c*nc;
+        for (int i = 0; i < nc; ++i) {
+            d[i] = v[p.s_idx[k] + i];
+        }
+    }
+}
